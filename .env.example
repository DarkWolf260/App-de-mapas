# Copia este archivo a `.env` y completa los valores.
# VITE_: se incrustan en el bundle del cliente. No pongas secretos con prefijo VITE_.
# La URL y anon key son públicas (seguras para una SPA); el control de acceso se
# implementa vía RLS en Supabase.

VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="TU_STANDARD_ANON_KEY_PUBLICA"

# Opcional: si algún día usas el SDK de ArcGIS (Maps SDK) con clave.
# VITE_ARCGIS_API_KEY=""